---
import "../styles/tokens.css";
import home from "../content/home.json";

interface Props {
  title?: string;
  description?: string;
}

// Defaults: the site title and SRK's mission statement, from home.json.
const {
  title = home.meta.title,
  description = home.hero.mission,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
