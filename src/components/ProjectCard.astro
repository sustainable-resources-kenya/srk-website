---
// Project card, layout C: colored band on top, tag, title, description, link.
// Text only, no images. The link's visible text is "Learn more"; the card title
// is added as hidden text so screen readers hear which project it's about.
// Wording is passed in from src/content/home.json.

interface Props {
  tag: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
  accent: "leaf" | "primary" | "river";
}

const { tag, title, description, href, linkLabel, accent } = Astro.props;
---

<article class={`card accent-${accent}`}>
  <div class="band" aria-hidden="true"></div>
  <div class="content">
    <p class="tag">{tag}</p>
    <h3>{title}</h3>
    <p class="description">{description}</p>
    <a class="link" href={href}>{linkLabel}<span class="visually-hidden">: {title}</span></a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-white);
    border: var(--border-thin) solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* Colored band */
  .band {
    height: var(--size-card-band);
  }
  .accent-leaf .band { background: var(--color-leaf); }
  .accent-primary .band { background: var(--color-primary); }
  .accent-river .band { background: var(--color-river); }

  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    flex-grow: 1;
    padding: var(--space-5);
  }
  p,
  h3 {
    margin: 0;
  }

  /* Category tag */
  .tag {
    padding: var(--space-1) var(--space-3);
    background: var(--color-tint);
    color: var(--color-primary);
    border-radius: var(--radius-pill);
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    font-weight: var(--font-weight-bold);
  }
  h3 {
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line);
    font-weight: var(--font-weight-bold);
  }
  .description {
    flex-grow: 1;
    color: var(--color-muted);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
  }

  /* "Learn more": text link */
  .link {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-tap);
    color: var(--color-primary);
    font-size: var(--text-ui-size);
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
    border-radius: var(--radius-xs);
  }
  .link:hover {
    color: var(--color-primary-hover);
    text-decoration-thickness: var(--underline-thick);
  }
  .link:active {
    color: var(--color-ink);
    text-decoration-thickness: var(--underline-thick);
  }
  .link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-ink);
    outline-offset: var(--focus-ring-offset);
  }
</style>
